# ---------------------------------------------------------------------------
# OKX API credentials
# ---------------------------------------------------------------------------
# Create at: OKX -> Profile -> API -> Create V5 API key
#
#   * Permissions: enable "Read" and "Withdraw". Do NOT enable "Trade" unless
#     you actually need it — this bot never trades.
#   * IP allow-list: REQUIRED for withdrawal permission. Set it to this
#     machine's public IP. Without it OKX rejects withdrawals with code 50110.
#   * The passphrase below is the API passphrase you chose when creating the
#     key — not your OKX login password.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Leave as-is unless you are on a regional domain (e.g. https://my.okx.com)
OKX_BASE_URL=https://www.okx.com

# Set to true to hit OKX demo trading instead of live funds.
OKX_SIMULATED=false

OKX_TIMEOUT_MS=20000
OKX_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Local approval factors
# ---------------------------------------------------------------------------
# Which factors must ALL pass before a withdrawal is submitted.
# Options: totp, email, sms.  Order is the order you are prompted.
# This is a local gate enforced by this bot, in addition to (never instead of)
# OKX's own API key restrictions.
AUTH_FACTORS=totp

# Encrypts the authenticator seed at rest and peppers stored OTP hashes.
# Generate with:  node src/index.js auth keygen
# Changing it makes an existing enrollment unreadable — re-run `auth setup`.
KOX_ENCRYPTION_KEY=

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3

# --- email codes (needed only if "email" is in AUTH_FACTORS) ---------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OTP_EMAIL_TO=

# --- sms codes (needed only if "sms" is in AUTH_FACTORS) -------------------
# Requires the optional twilio package:  npm install twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
OTP_SMS_TO=

# ---------------------------------------------------------------------------
# Safety limits
# ---------------------------------------------------------------------------
# Refuse to send to any address not saved via `kox address add`.
# Strongly recommended: leave this on.
REQUIRE_ADDRESS_BOOK=true

# Per-transaction and rolling-24h ceilings, in the withdrawn currency's units.
# Leave blank for no limit.
MAX_WITHDRAWAL_AMOUNT=
MAX_DAILY_WITHDRAWAL_AMOUNT=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DB_PATH=data/kox.db
LOG_LEVEL=info
